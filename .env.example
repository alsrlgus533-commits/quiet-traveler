# 이 파일을 복사해 .env 로 이름을 바꾸고 키를 채우세요. (.env 는 git·제출 ZIP 에 들어가지 않습니다)
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env

# ===== AI (필수: 대화형 에이전트) =====
# 업스테이지 콘솔(console.upstage.ai) > API Keys 에서 발급. 없으면 화면은 뜨지만 AI 대화는 꺼집니다.
UPSTAGE_API_KEY=
# (선택) 모델 이름. 기본 solar-pro4
UPSTAGE_MODEL=solar-pro4
# (선택) 첫 화면 추천을 AI 가 고를 때 쓰는 가벼운 모델. 기본 solar-mini4 (1회 약 550토큰, 같은 후보면 캐시)
UPSTAGE_PICKS_MODEL=solar-mini4
# (선택) 공개 주소에 띄울 때 첫 화면 AI 선별 호출 수 제한. 0 이면 제한 없음. 넘으면 계산식 순서로 보여 줌
PICKS_LIMIT_PER_DAY=0
PICKS_LIMIT_PER_IP_HOUR=0

# ===== 제주데이터허브 (필수 데이터) =====
# jejudatahub.net 로그인 > 마이페이지 > 프로젝트에서 발급한 프로젝트 키.
# 저장본(agent/data/datahub_card_time.json)이 함께 들어 있어 키 없이도 실행됩니다. 새로 받을 때만 필요: python -m agent.datahub
JEJU_DATAHUB_KEY=

# ===== 공공데이터포털 (관광지 예측·날씨) =====
# 일반 인증키(Decoding). 아래 서비스에 각각 활용신청이 되어 있어야 합니다.
#  - 한국관광공사_관광지 집중률 방문자 추이 예측 정보 (15128555)  -> python fetch_forecast.py
#  - 한국관광공사_국문 관광정보 서비스 (TourAPI, KorService2)      -> 장소 사진·좌표를 다시 받을 때만
#  - 기상청_단기예보 조회서비스, 기상청_중기예보 조회서비스          -> 날씨 (KMA_API_KEY 가 없을 때)
TOUR_API_KEY=

# (선택) 기상청 API허브(apihub.kma.go.kr) authKey. 단기예보·중기예보(육상·기온) 활용신청 필요. 있으면 날씨는 이 키를 먼저 씁니다.
KMA_API_KEY=

# (선택) 제주관광공사 비짓제주 관광정보 OPEN API 키 -> 장소 사진을 다시 받을 때만
VISITJEJU_API_KEY=
